# Editorial Manager 상태 감시 설정: 내 컴퓨터에서 돌릴 때만 씁니다.
# GitHub Actions에서는 이 파일 대신 저장소의 Secrets에 넣으세요.
# 이 파일을 config.env로 복사해 값을 채운 뒤 chmod 600 config.env 로 본인만 읽게 하세요.
# (English: copy this file to config.env, fill in the values, then run chmod 600 config.env.)

# 저널 EM 주소 (로그인 화면 주소의 앞부분, 예: https://www.editorialmanager.com/abcd/)
EM_SITE=
# 그 저널 EM의 저자 계정 (ORCID 계정이 아님)
EM_USERNAME=
EM_PASSWORD=

# Slack Incoming Webhook 주소
SLACK_WEBHOOK_URL=

# 연구실 알림 중계 주소와 개인 키를 받았다면 웹훅 대신 이 두 줄을 채우세요
# SLACK_RELAY_URL=
# SLACK_RELAY_KEY=

# 선택: 알림 언어(ko 또는 en), 알림마다 붙일 멘션, 알림에 표시할 저널 이름
# NOTIFY_LANG=en
# SLACK_MENTION=<!channel>
# JOURNAL_NAME=
